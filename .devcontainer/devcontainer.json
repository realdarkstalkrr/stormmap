{
  "name": "StormMap",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": { "label": "StormMap", "onAutoForward": "openBrowser" }
  },
  "postAttachCommand": "python3 server.py",
  "customizations": {
    "codespaces": { "openFiles": ["README.md"] }
  }
}
